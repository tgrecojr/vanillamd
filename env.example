# Copy this file to .env for local development:  cp env.example .env
#
# Directory where notes are stored (mapped volume in the container).
# Inside the container this is /data; mount your host folder there.
DATA_DIR=/data

# Port the server listens on.
PORT=8080

# Host/interface to bind. 0.0.0.0 inside a container is expected;
# this app does NO authentication of its own and must sit behind
# Cloudflare Zero Trust (or an equivalent access proxy).
HOST=0.0.0.0

# Max UTF-8 size of a single note's content, in bytes (default 5 MiB). Enforced
# explicitly on write (HTTP 413 if exceeded); the request body limit is this
# value plus a small allowance for JSON framing.
MAX_NOTE_BYTES=5242880

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Milliseconds a single request may take before its socket is reclaimed.
# Fastify defaults this to 0, which disables Node's own 300 s ceiling and lets
# a slow client hold a connection indefinitely.
REQUEST_TIMEOUT_MS=300000

# Maximum concurrent sockets held open by the server.
MAX_CONNECTIONS=512

# Per-client request budget: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
# Generous by default — the editor autosaves on a debounce, so normal use stays
# well under it. Clients over the budget get HTTP 429.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Which peers may set X-Forwarded-* headers. Unset means trust nobody, so
# request.ip is the real socket peer.
#
# IMPORTANT: behind Cloudflare Zero Trust you WANT the real client IP in logs,
# so set this to the tunnel's address/CIDR (or a hop count). Leaving it unset
# is safe but logs will show the tunnel/socket peer instead of the end client.
#   TRUST_PROXY=1                       # trust one hop
#   TRUST_PROXY=10.0.0.0/8,172.16.0.1   # trust these proxies
TRUST_PROXY=

# Aggregate ceilings across the whole data directory, on top of the per-note
# limit. Deliberately generous so an existing deployment keeps working after
# upgrade; tighten them to match the volume you mounted. Exceeding either
# returns HTTP 413.
MAX_TOTAL_BYTES=1073741824
MAX_ENTRIES=10000
