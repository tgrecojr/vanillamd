# Copy this file to .env for local development:  cp env.example .env
#
# Directory where notes are stored (mapped volume in the container).
# Inside the container this is /data; mount your host folder there.
DATA_DIR=/data

# Port the server listens on.
PORT=8080

# Host/interface to bind. 0.0.0.0 inside a container is expected;
# this app does NO authentication of its own and must sit behind
# Cloudflare Zero Trust (or an equivalent access proxy).
HOST=0.0.0.0

# Max UTF-8 size of a single note's content, in bytes (default 5 MiB). Enforced
# explicitly on write (HTTP 413 if exceeded); the request body limit is this
# value plus a small allowance for JSON framing.
MAX_NOTE_BYTES=5242880

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
